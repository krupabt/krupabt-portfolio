# ==============================================================
# KRUPA PORTFOLIO - PRIVATE VISITOR ANALYTICS CONFIGURATION
# ==============================================================

# Admin Security Credentials
# Set these in your local .env or Vercel Project Settings -> Environment Variables
ADMIN_USERNAME=krupabt
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=generate_a_random_32_character_string_here

# --------------------------------------------------------------
# Database Options (Optional)
# If left empty, the built-in resilient serverless engine will be used.
# --------------------------------------------------------------

# Option A: Supabase (Recommended free-tier PostgreSQL)
# Copy from Supabase Project Settings -> API
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Option B: Vercel KV / Upstash Redis
# KV_REST_API_URL=https://your-upstash-redis.upstash.io
# KV_REST_API_TOKEN=your_token
